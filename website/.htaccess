ErrorDocument 404 /404.html

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS erzwingen und die Hauptdomain ohne www kanonisieren.
  # ACME-Challenges bleiben erreichbar, damit Let's Encrypt Zertifikate erneuern kann.
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/ [NC]
  RewriteCond %{HTTP_HOST} ^www\.glanzerdigital\.at$ [NC]
  RewriteRule ^ https://glanzerdigital.at%{REQUEST_URI} [R=301,L]

  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Wartungsmodus: Die versteckte Datei wird ausschließlich vom Adminbereich gesetzt.
  RewriteCond %{DOCUMENT_ROOT}/.maintenance -f
  RewriteCond %{REQUEST_URI} !^/maintenance\.php$ [NC]
  RewriteCond %{REQUEST_URI} !^/admin(?:/|$) [NC]
  RewriteCond %{REQUEST_URI} !^/assets(?:/|$) [NC]
  RewriteCond %{REQUEST_URI} !^/api/analytics-track\.php$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known(?:/|$) [NC]
  RewriteRule ^ maintenance.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<FilesMatch "(^\.|\.(?:bak|backup|log|map|md|sql|env|zip)$)">
  Require all denied
</FilesMatch>


<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
